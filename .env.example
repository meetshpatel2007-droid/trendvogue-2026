# Trend Vogue Environment Variables
# Copy to `.env` — read by both Next.js and the Prisma CLI (migrate / seed).

# Database (matches docker-compose.yml for local dev)
DATABASE_URL="postgresql://trendvogue:trendvogue@localhost:5432/trend_vogue?schema=public"

# JWT Secrets
JWT_ACCESS_SECRET="change-me-to-a-strong-random-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-to-another-strong-random-secret-min-32-chars"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Admin Seed Account Credentials (used only by prisma/seed.ts)
ADMIN_SEED_EMAIL="Meet2026@gmail.com"
ADMIN_SEED_PASSWORD="Meet@@2026"
ADMIN_SEED_NAME="Meet Admin"
